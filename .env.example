# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# TEAMFORGE â€” environment placeholders. Copy to .env and fill in.
# NEVER commit a real .env. No third-party LLM keys exist here by design:
# the six AI-tooling agents run inside this backend and talk Switch.
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

# â”€â”€ Core â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://127.0.0.1:5183
# Shared secret for the dashboard API. Generate: openssl rand -hex 32
TEAMFORGE_API_KEY=change-me-dev-key
ORG_SLUG=acme
ORG_NAME=Teamforge Workspace
ORG_TIMEZONE=Asia/Kolkata

# â”€â”€ AI brain: OpenCode (your OpenCode plan), headless â”€â”€â”€â”€â”€â”€â”€â”€â”€
# The model decides what to remember, which tools to call, and how to reply.
# Uses the authenticated OpenCode CLI on this machine â€” no extra API keys.
OPENCODE_BRAIN_DIR=brain
OPENCODE_MODEL=            # blank = OpenCode's default model (e.g. opencode-go/...)
OPENCODE_TIMEOUT_MS=45000
AI_FALLBACK_DETERMINISTIC=true  # if the model is unavailable, use the safe offline engine
# Optional: fully Switch-managed AI. Create an agent named teamforge-ai in Switch Console
# (provider: OpenCode, Directory: apps/api/brain, invite it to the room), then:
SWITCH_AI_RELAY=false           # true = forward messages to the Switch-managed AI agent (no local model call)
SWITCH_AI_AGENT_NAME=teamforge-ai

# â”€â”€ MongoDB â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Local MongoDB service (or Atlas). TEAMFORGE uses its own db, isolated from other apps.
MONGODB_URI=mongodb://127.0.0.1:27017/teamforge-ops

# â”€â”€ Switch (local server runs inside Switch Console) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Keep Switch Console open: its native local server provides the bridge (56565).
SWITCH_SERVER_URL=http://127.0.0.1:56565
# Registration key (Gateway â†’ API Keys â†’ type "registration"). Required for live agents.
SWITCH_REGISTRATION_TOKEN=
# Optional: Gateway admin account, used to open agent addressing automatically.
SWITCH_GATEWAY_EMAIL=
SWITCH_GATEWAY_PASSWORD=
# Runtime behaviour
SWITCH_AUTO_CONNECT=true          # register/connect the six agents on boot
SWITCH_AUTO_PROVISION=true        # create/find the room automatically
SWITCH_AUTO_ROUTE=true            # route incoming messages to agents
SWITCH_INTERNAL_ONLY=false        # false = bridged room (Discord/Mattermost); true = agent-only room
SWITCH_ROOM_NAME=teamforge-lobby  # room + fresh Discord channel created by Switch
SWITCH_ROOM_DESCRIPTION=TEAMFORGE ops room â€” people and AI teammates working together through Switch. Say anything; no @mentions needed.
SWITCH_BRIDGE_ID=                 # optional: pin a bridge; blank = prefer Discord, else default
SWITCH_CHANNEL_TYPE=channel_public
SWITCH_USER_NAMES=                # optional comma-separated platform usernames to add to the room
# Keeps TEAMFORGE agents distinct from any earlier build on the same server.
# Names become ops-manager-tf, project-manager-tf, â€¦ (leave "-tf"; empty only if you retired earlier agents).
SWITCH_AGENT_SUFFIX=-tf
SWITCH_CREDENTIALS_PATH=data/switch-credentials.json  # agent API keys (file, 0600, gitignored)

# â”€â”€ Proactive behaviour â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
MORNING_BRIEF_CRON=30 8 * * *
PROACTIVE_MAX_PER_DAY=6
QUIET_HOURS_START=21:30
QUIET_HOURS_END=08:30
# true = proactive items recorded on the dashboard only; false = posted into the Switch room by the agents
TEAMFORGE_DEMO_MODE=false
